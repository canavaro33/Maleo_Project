// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum Role {
  admin
  kepala_sekolah
  teacher
  student
  guardian
}

enum Gender {
  L
  P
}

enum Semester {
  Ganjil
  Genap
}

enum AttendanceStatus {
  hadir
  izin
  sakit
  alpa
}

enum TeacherAttendStatus {
  hadir
  terlambat
  izin
  sakit
  alpa
}

enum CheckinType {
  self
  admin_override
}

enum ScoreType {
  Tugas
  PSTS
  PSAS
  Kuis
}

enum AnnouncementTarget {
  all
  teacher
  student
  guardian
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum Status {
  active
  inactive
}

enum MaterialType {
  pdf
  ppt
  pptx
  doc
  docx
  video
  image
  link
}

// ──────────────────────────────────────────────
// RPS ENUMS
// ──────────────────────────────────────────────

enum RPSStatus {
  draft
  published
  archived
}

enum MeetingStatus {
  draft
  published
  archived
}

enum MaterialTypeRPS {
  pdf
  ppt
  pptx
  docx
  video_link
  zip
  image
  link
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

// User = Authentication only.
// Profile data lives in Student, Teacher, Principal, Guardian.
// One of the FK columns below will be non-null based on role.
model User {
  id                    Int     @id @default(autoincrement())
  name                  String
  email                 String? @unique
  nipNis                String? @unique @map("nip_nis")
  userCode              String? @map("user_code")
  password              String
  role                  Role    @default(admin)
  force_change_password Boolean @default(true)

  // Separate FK per profile type — clean 1-User-1-Role-1-Profile
  studentId   Int? @unique @map("student_id")
  teacherId   Int? @unique @map("teacher_id")
  principalId Int? @unique @map("principal_id")
  guardianId  Int? @unique @map("guardian_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student   Student?   @relation(fields: [studentId], references: [id])
  teacher   Teacher?   @relation(fields: [teacherId], references: [id])
  principal Principal? @relation(fields: [principalId], references: [id])
  guardian  Guardian?  @relation(fields: [guardianId], references: [id])

  @@map("users")
}

model Student {
  id        Int       @id @default(autoincrement())
  nis       String    @unique
  name      String
  gender    Gender?
  birthDate DateTime? @map("birth_date")
  address   String?
  phone     String?
  status    Status    @default(active)
  classId   Int       @map("class_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  class             Class                   @relation(fields: [classId], references: [id])
  guardians         Guardian[]              @relation("StudentGuardians")
  attendances       Attendance[]
  grades            Grade[]
  materialAccess    StudentMaterialAccess[]
  rpsMaterialAccess RPSMaterialAccess[]
  submissions       AssignmentSubmission[]
  user              User?

  @@map("students")
}

model Teacher {
  id        Int      @id @default(autoincrement())
  nip       String   @unique
  name      String
  gender    Gender?
  email     String   @unique
  phone     String?
  subject   String?
  status    Status   @default(active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  homeroomClasses    Class[]             @relation("HomeroomTeacher")
  subjects           Subject[]
  schedules          Schedule[]
  contents           Content[]
  assignments        Assignment[]
  learningModules    LearningModule[]
  teacherAttendances TeacherAttendance[]
  user               User?
  rps                RPS[]
  teacherSubjects    TeacherSubject[]
  gradeConfigs       GradeConfig[]

  @@map("teachers")
}

model Principal {
  id            Int      @id @default(autoincrement())
  nip           String   @unique
  name          String
  gender        Gender?
  email         String?  @unique
  phone         String?
  address       String?
  principalCode String   @map("principal_code")
  status        Status   @default(active)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User?

  @@map("principals")
}

model Guardian {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  email      String   @unique
  address    String?
  occupation String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  students Student[] @relation("StudentGuardians")
  user     User?

  @@map("guardians")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String
  semester  Semester
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learningModules LearningModule[]
  rps             RPS[]

  @@map("academic_years")
}

model Class {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  level             Int
  homeroomTeacherId Int      @map("homeroom_teacher_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  homeroomTeacher Teacher          @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students        Student[]
  schedules       Schedule[]
  contents        Content[]
  assignments     Assignment[]
  learningModules LearningModule[]
  rps             RPS[]
  gradeConfigs    GradeConfig[]

  @@map("classes")
}

model Subject {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  gradeLevel   Int      @map("grade_level")
  hoursPerWeek Int      @map("hours_per_week")
  teacherId    Int      @map("teacher_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teacher         Teacher          @relation(fields: [teacherId], references: [id])
  schedules       Schedule[]
  grades          Grade[]
  contents        Content[]
  assignments     Assignment[]
  learningModules LearningModule[]
  teacherSubjects TeacherSubject[]
  rps             RPS[]
  gradeConfigs    GradeConfig[]

  @@map("subjects")
}

model Schedule {
  id        Int      @id @default(autoincrement())
  day       String
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  room      String
  subjectId Int      @map("subject_id")
  teacherId Int      @map("teacher_id")
  classId   Int      @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@map("schedules")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime
  status    AttendanceStatus
  note      String?
  studentId Int              @map("student_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model Grade {
  id        Int       @id @default(autoincrement())
  type      ScoreType
  score     Float
  maxScore  Float     @map("max_score")
  date      DateTime
  studentId Int       @map("student_id")
  subjectId Int       @map("subject_id")

  isLocked   Boolean   @default(false) @map("is_locked")
  lockedAt   DateTime? @map("locked_at")
  lockedBy   Int?      @map("locked_by")
  unlockedAt DateTime? @map("unlocked_at")
  unlockedBy Int?      @map("unlocked_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@map("grades")
}

model GradeConfig {
  id         Int       @id @default(autoincrement())
  teacherId  Int       @map("teacher_id")
  subjectId  Int       @map("subject_id")
  classId    Int       @map("class_id")
  isLocked   Boolean   @default(false) @map("is_locked")
  lockedAt   DateTime? @map("locked_at")
  lockedBy   Int?      @map("locked_by")
  unlockedBy Int?      @map("unlocked_by")
  unlockedAt DateTime? @map("unlocked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  teacher    Teacher          @relation(fields: [teacherId], references: [id])
  subject    Subject          @relation(fields: [subjectId], references: [id])
  class      Class            @relation(fields: [classId], references: [id])
  components GradeComponent[]

  @@unique([teacherId, subjectId, classId])
  @@map("grade_configs")
}

model GradeComponent {
  id            Int     @id @default(autoincrement())
  gradeConfigId Int     @map("grade_config_id")
  name          String
  weight        Float
  isDefault     Boolean @default(true) @map("is_default")
  order         Int     @default(0)

  gradeConfig GradeConfig @relation(fields: [gradeConfigId], references: [id], onDelete: Cascade)

  @@map("grade_components")
}

model Announcement {
  id          Int                  @id @default(autoincrement())
  title       String
  content     String
  author      String
  target      AnnouncementTarget   @default(all)
  priority    AnnouncementPriority @default(normal)
  isPublished Boolean              @default(false) @map("is_published")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("announcements")
}

model Content {
  id        Int      @id @default(autoincrement())
  title     String
  type      String
  url       String
  teacherId Int      @map("teacher_id")
  classId   Int      @map("class_id")
  subjectId Int      @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@map("contents")
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime @map("due_date")
  fileUrl     String?  @map("file_url")
  fileType    String?  @map("file_type")
  teacherId   Int      @map("teacher_id")
  classId     Int      @map("class_id")
  subjectId   Int      @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher     Teacher                @relation(fields: [teacherId], references: [id])
  class       Class                  @relation(fields: [classId], references: [id])
  subject     Subject                @relation(fields: [subjectId], references: [id])
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id")
  studentId    Int      @map("student_id")
  fileUrl      String?  @map("file_url")
  fileType     String?  @map("file_type")
  fileName     String?  @map("file_name")
  content      String?  @db.Text
  submittedAt  DateTime @default(now()) @map("submitted_at")
  grade        Float?
  feedback     String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model LearningModule {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  subjectId      Int      @map("subject_id")
  academicYearId Int      @map("academic_year_id")
  teacherId      Int      @map("teacher_id")
  classId        Int?     @map("class_id")
  order          Int      @default(0)
  isPublished    Boolean  @default(false) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subject      Subject         @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
  teacher      Teacher         @relation(fields: [teacherId], references: [id])
  class        Class?          @relation(fields: [classId], references: [id])
  sessions     ModuleSession[]

  @@map("learning_modules")
}

model ModuleSession {
  id            Int      @id @default(autoincrement())
  moduleId      Int      @map("module_id")
  sessionNumber Int      @map("session_number")
  title         String
  isRepeatable  Boolean  @default(false) @map("is_repeatable")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  module    LearningModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials SessionMaterial[]

  @@map("module_sessions")
}

model SessionMaterial {
  id        Int          @id @default(autoincrement())
  sessionId Int          @map("session_id")
  title     String
  type      MaterialType
  fileUrl   String       @map("file_url")
  order     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  session ModuleSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  access  StudentMaterialAccess[]

  @@map("session_materials")
}

model StudentMaterialAccess {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  materialId Int      @map("material_id")
  accessedAt DateTime @default(now()) @map("accessed_at")

  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material SessionMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("student_material_access")
}

// ──────────────────────────────────────────────
// RPS SYSTEM MODELS
// ──────────────────────────────────────────────

// Model RPS — induk utama Rencana Pembelajaran Semester
model RPS {
  id Int @id @default(autoincrement())

  // 3 Nomor Induk Otomatis
  nomorInduk1 String @unique @map("nomor_induk_1") // RPS/{LEVEL}/{YEAR}/{SEQ}
  nomorInduk2 String @unique @map("nomor_induk_2") // MOD/{SUBJECT_CODE}/{YEAR}/{SEQ}
  nomorInduk3 String @unique @map("nomor_induk_3") // ATP/{YEAR}/{SEQ}

  // Relasi ke data master
  subjectId      Int @map("subject_id")
  classId        Int @map("class_id")
  teacherId      Int @map("teacher_id")
  academicYearId Int @map("academic_year_id")

  // Metadata RPS
  totalMeetings Int       @default(16) @map("total_meetings")
  status        RPSStatus @default(draft)
  publishedAt   DateTime? @map("published_at")
  archivedAt    DateTime? @map("archived_at")

  // Input manual guru
  learningObjective String? @map("learning_objective") @db.Text
  learningStrategy  String? @map("learning_strategy") @db.Text
  teacherNote       String? @map("teacher_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject      Subject      @relation(fields: [subjectId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  meetings     RPSMeeting[]

  // Unique: 1 guru hanya bisa punya 1 RPS per mapel+kelas+semester
  @@unique([subjectId, classId, teacherId, academicYearId])
  @@map("rps")
}

// Model RPSMeeting — pertemuan dalam RPS
model RPSMeeting {
  id            Int @id @default(autoincrement())
  rpsId         Int @map("rps_id")
  meetingNumber Int @map("meeting_number") // 1, 2, 3, ...16

  // Input manual guru per pertemuan
  title        String? // judul pertemuan
  learningPath String? @map("learning_path") @db.Text // alur pembelajaran
  learningGoal String? @map("learning_goal") @db.Text // tujuan pembelajaran
  activity     String? @db.Text // strategi/aktivitas
  assessment   String? @db.Text // penilaian

  status      MeetingStatus @default(draft)
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rps       RPS           @relation(fields: [rpsId], references: [id], onDelete: Cascade)
  materials RPSMaterial[]

  // 1 meeting unik per nomor dalam 1 RPS
  @@unique([rpsId, meetingNumber])
  @@map("rps_meetings")
}

// Model RPSMaterial — materi dalam pertemuan
model RPSMaterial {
  id        Int             @id @default(autoincrement())
  meetingId Int             @map("meeting_id")
  title     String
  type      MaterialTypeRPS
  fileUrl   String          @map("file_url")
  fileName  String?         @map("file_name")
  fileSize  Int?            @map("file_size") // bytes
  mimeType  String?         @map("mime_type")
  order     Int             @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting RPSMeeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  access  RPSMaterialAccess[]

  @@map("rps_materials")
}

// Tracking akses materi RPS oleh siswa
model RPSMaterialAccess {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  materialId Int      @map("material_id")
  accessedAt DateTime @default(now()) @map("accessed_at")

  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material RPSMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@map("rps_material_access")
}

// Many-to-many Teacher <-> Subject (max 2 per guru)
model TeacherSubject {
  id        Int     @id @default(autoincrement())
  teacherId Int     @map("teacher_id")
  subjectId Int     @map("subject_id")
  isPrimary Boolean @default(false) @map("is_primary")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

model TeacherAttendance {
  id             Int                 @id @default(autoincrement())
  teacherId      Int                 @map("teacher_id")
  date           DateTime
  status         TeacherAttendStatus
  checkinAt      DateTime?           @map("checkin_at")
  checkinType    CheckinType         @default(self) @map("checkin_type")
  note           String?
  isLate         Boolean             @default(false) @map("is_late")
  lateMinutes    Int?                @map("late_minutes")
  overriddenBy   Int?                @map("overridden_by")
  overriddenAt   DateTime?           @map("overridden_at")
  overrideReason String?             @map("override_reason")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@map("teacher_attendances")
}

enum ConsultationStatus {
  unread
  read
  replied
}

model Consultation {
  id         Int                @id @default(autoincrement())
  senderId   Int                @map("sender_id")
  receiverId Int                @map("receiver_id")
  senderRole Role               @map("sender_role")
  subject    String
  message    String             @db.Text
  status     ConsultationStatus @default(unread)
  parentId   Int?               @map("parent_id")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  parent  Consultation?  @relation("ConsultationReplies", fields: [parentId], references: [id])
  replies Consultation[] @relation("ConsultationReplies")

  @@map("consultations")
}
